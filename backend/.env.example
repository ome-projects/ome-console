# Server Configuration
PORT=8080
GIN_MODE=debug

# Kubernetes Configuration
KUBERNETES_IN_CLUSTER=false
KUBECONFIG=~/.kube/config

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Startup waits this long (Go duration) for the Kubernetes caches to fill, then fails
# with an error naming the resource instead of hanging on a missing CRD or permission.
INFORMER_SYNC_TIMEOUT=60s

# Field validation for writes. Strict (default) rejects fields the installed OME CRD does not
# declare; Warn or Ignore lets the API server drop them silently.
OME_FIELD_VALIDATION=Strict

# Most instance rows one InferenceReplica status may expand to (OME's CLI uses 20000)
OME_MAX_DECODED_INSTANCES=20000
