# Server Configuration
PORT=8080
GIN_MODE=debug

# Kubernetes Configuration
KUBERNETES_IN_CLUSTER=false
KUBECONFIG=~/.kube/config

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Startup waits this long (Go duration) for the Kubernetes caches to fill, then fails
# with an error naming the resource instead of hanging on a missing CRD or permission.
INFORMER_SYNC_TIMEOUT=60s
